{
  "manifest_version": 3,
  "name": "TrueDiff: real PR size, without the tests",
  "short_name": "TrueDiff",
  "version": "0.0.0",
  "description": "Shows the real size of a GitHub pull request without tests and other noise, and marks the noise as viewed in one click.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TrueDiff settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "minimum_chrome_version": "110"
}
